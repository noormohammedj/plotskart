{
  "name": "plotskart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:site3d": "vite build --config vite.site3d.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "build:app": "npm run build && cap sync",
    "android:apk": "npm run build:app && node scripts/gradle.mjs assembleDebug",
    "android": "npm run build:app && cap open android",
    "ios": "npm run build:app && cap open ios",
    "test:db": "node supabase/tests/db.test.mjs",
    "test:fn": "node supabase/tests/whatsapp.test.mjs",
    "deploy": "npm run build && npx -y netlify-cli deploy --prod --dir dist --no-build",
    "deploy:website": "npm run build:site3d && npx -y netlify-cli deploy --prod --dir website --no-build --site 3c7869a1-9842-4c81-87a5-1b4903505d2e",
    "test:race": "npx -y tsx src/m/raceCore.test.ts"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.118.0",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "^0.5.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "supabase": "^2.121.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
