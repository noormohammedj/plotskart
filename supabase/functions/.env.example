# Set these with: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.)

# Same random value you stored in Vault as 'deliver_secret'
DELIVER_SECRET=change-me-to-a-long-random-string

# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on one line.
FCM_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# Meta WhatsApp Cloud API (WhatsApp Manager > API setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LANGUAGE=en

# MSG91 SMS (DLT-registered templates)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_BOOKING_CONFIRMATION=
MSG91_TEMPLATE_REGISTRATION_REMINDER=
MSG91_TEMPLATE_PAYMENT_REMINDER=
